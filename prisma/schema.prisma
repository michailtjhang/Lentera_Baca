// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Novel {
  id            String    @id @default(cuid())
  title         String    @unique                      // judul harus unik
  slug          String    @unique                      // slug untuk url
  author        String
  illustrator   String?                                // penambahan illustrator
  description   String?
  coverImage    String?
  coverImageKey String?                                // Key dari UploadThing
  type          NovelType @default(WEB)                // tipe novel
  region        Region    @default(OTHER)              // regional novel
  status        Status    @default(ONGOING)            // ongoing, complete, drop, hiatus
  genres        Genre[]
  tags          Tag[]
  chapters      Chapter[]
  volumes       Volume[]                               // relasi ke volumes (untuk PDF/EPUB)
  views         Int       @default(0)                    // total views novel
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Status {
  ONGOING
  COMPLETE
  DROP
  HIATUS
}

enum NovelType {
  WEB
  LIGHTNOVEL_WEB
  LIGHTNOVEL_PDF
  EPUB
}

enum Region {
  JAPAN
  KOREA
  CHINA
  OTHER
}

model Genre {
  id     String  @id @default(cuid())
  name   String  @unique
  novels Novel[]
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  novels Novel[]
}

model Chapter {
  id        String      @id @default(cuid())
  title     String?
  content   String      @db.Text
  order     Int
  type      ChapterType @default(STORY)
  novelId   String
  novel     Novel       @relation(fields: [novelId], references: [id], onDelete: Cascade)
  volumeId  String?
  volume    Volume?     @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  views     Int         @default(0)                    // total views per chapter
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([novelId])
  @@index([order])
  @@index([volumeId])
}

enum ChapterType {
  PROLOGUE
  STORY
  ILLUSTRATION
  EPILOGUE
  SIDESTORY
  INTERLUDE
}

// ── Volumes (Shared for PDF/EPUB) ──────────────────────────────────
model Volume {
  id        String   @id @default(cuid())
  title     String   // Misal: "Volume 1", "Edisi Spesial"
  order     Int      @default(1)
  fileUrl   String?  // URL dari UploadThing (Optional for WEB grouped volumes)
  fileKey   String?  // Key dari UploadThing untuk hapus file
  fileType  FileType @default(PDF)
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  views     Int      @default(0)                    // total views per volume
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([novelId])
  @@index([order])
}

enum FileType {
  PDF
  EPUB
}
