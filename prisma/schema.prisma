// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Novel {
  id          String    @id @default(cuid())
  title       String    @unique                      // judul harus unik
  slug        String    @unique                      // slug untuk url
  author      String
  description String?
  coverImage  String?
  status      Status    @default(ONGOING)           // ongoing, complete, drop, hiatus
  genres      Genre[]
  tags        Tag[]
  chapters    Chapter[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Status {
  ONGOING
  COMPLETE
  DROP
  HIATUS
}

model Genre {
  id     String  @id @default(cuid())
  name   String  @unique
  novels Novel[]
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  novels Novel[]
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  order     Int
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([novelId])
  @@index([order])
}

// ── Light Novel ────────────────────────────────────────────────
model LightNovel {
  id             String      @id @default(cuid())
  title          String      @unique
  slug           String      @unique
  author         String
  description    String?
  coverImage     String?
  coverImageKey  String?     // Key dari UploadThing untuk hapus file
  status         Status      @default(ONGOING)
  genres         LNGenre[]
  volumes        Volume[]    // Relasi ke banyak volume
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Volume {
  id           String      @id @default(cuid())
  title        String      // Misal: "Volume 1", "Edisi Spesial"
  order        Int         @default(1)
  fileUrl      String      // URL dari UploadThing
  fileKey      String      // Key dari UploadThing untuk hapus file
  fileType     FileType    @default(PDF)
  lightNovelId String
  lightNovel   LightNovel  @relation(fields: [lightNovelId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([lightNovelId])
  @@index([order])
}

enum FileType {
  PDF
  EPUB
}

model LNGenre {
  id          String       @id @default(cuid())
  name        String       @unique
  lightNovels LightNovel[]
}
